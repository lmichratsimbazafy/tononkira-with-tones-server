PORT=8080
JWT_SECRET=change-me-in-production
BCRYPT_SECRET=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Connexion MongoDB (option 1 : URI complète)
DB_URI=mongodb://root:example@localhost:27017/tononkira?authSource=admin

# Connexion MongoDB (option 2 : composants séparés)
# DB_USER=root
# DB_PASSWORD=example
# DB_HOST=localhost
# DB_PORT=27017
DB_NAME=tononkira

# Hôte MongoDB utilisé par le script de seed
LOCAL_SCRIPT_DB_HOST=localhost
